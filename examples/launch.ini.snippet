; Add Vader360 to the [Plugins] section of your launch.ini (DashLaunch config,
; root of the USB stick used by XeUnshackle / XeUnshackle Max).
; Use any free slot. Keep Xbdm.xex in plugin1 if you use it.
;
; Plugin on the internal HDD (recommended once your setup boots without the USB stick):
;   plugin2 = Hdd:\Plugins\vader360.xex
; Plugin on the USB stick:
;   plugin2 = Usb:\Plugins\vader360.xex

[Plugins]
plugin1 = Usb:\Xbdm.xex
plugin2 = Hdd:\Plugins\vader360.xex
plugin3 = Usb:\JRPC2.xex
